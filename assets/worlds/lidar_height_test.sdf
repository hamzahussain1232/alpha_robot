<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="lidar_height_test">
    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <max_contacts>20</max_contacts>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::Magnetometer" filename="gz-sim-magnetometer-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.48 0.48 0.48 1</ambient>
      <background>0.73 0.80 0.89 1</background>
      <shadows>false</shadows>
      <grid>true</grid>
    </scene>

    <light name="test_sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 25 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>200</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.25 0.2 -0.95</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.58 0.60 0.56 1</ambient>
            <diffuse>0.58 0.60 0.56 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bounding walls (10m x 10m room). -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 0.2 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10 0.2 2.0</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 0.2 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10 0.2 2.0</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>5 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10 2.0</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10 2.0</size></box></geometry></visual>
      </link>
    </model>

    <!-- Height test obstacles placed ahead of robot spawn (0,0). -->
    <model name="obs_front_center_10cm">
      <static>true</static>
      <pose>1.2 0.0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.40 0.28 0.10</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.40 0.28 0.10</size></box></geometry>
          <material><diffuse>0.93 0.27 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obs_front_left_10cm">
      <static>true</static>
      <pose>1.9 0.5 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.40 0.30 0.10</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.40 0.30 0.10</size></box></geometry>
          <material><diffuse>0.98 0.72 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obs_front_right_10cm">
      <static>true</static>
      <pose>2.6 -0.5 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.40 0.30 0.10</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.40 0.30 0.10</size></box></geometry>
          <material><diffuse>0.14 0.58 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obs_far_center_10cm">
      <static>true</static>
      <pose>3.2 0.0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.50 0.35 0.10</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.50 0.35 0.10</size></box></geometry>
          <material><diffuse>0.36 0.76 0.36 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Long barrier to guarantee LaserScan hit even with high LiDAR mounting. -->
    <model name="obs_barrier_10cm">
      <static>true</static>
      <pose>1.8 0.0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 1.80 0.10</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.12 1.80 0.10</size></box></geometry>
          <material><diffuse>0.80 0.30 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Asymmetric tall landmarks (above lidar height) to prevent rotational aliasing. -->
    <model name="landmark_nw_tower">
      <static>true</static>
      <pose>-3.7 3.2 0.60 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.35 0.35 1.20</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.35 0.35 1.20</size></box></geometry>
          <material><diffuse>0.90 0.20 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="landmark_se_block">
      <static>true</static>
      <pose>3.4 -2.7 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.25 0.55 0.90</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.25 0.55 0.90</size></box></geometry>
          <material><diffuse>0.15 0.35 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="landmark_slanted_divider">
      <static>true</static>
      <pose>-1.2 -0.8 0.70 0 0 0.52</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.80 0.15 1.40</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.80 0.15 1.40</size></box></geometry>
          <material><diffuse>0.25 0.75 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
