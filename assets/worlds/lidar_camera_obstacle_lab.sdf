<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="lidar_camera_obstacle_lab">
    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <max_contacts>20</max_contacts>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.46 0.46 0.46 1</ambient>
      <background>0.72 0.78 0.86 1</background>
      <shadows>false</shadows>
      <grid>true</grid>
    </scene>

    <light name="lab_sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 25 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>220</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.25 0.2 -0.95</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.58 0.60 0.56 1</ambient>
            <diffuse>0.58 0.60 0.56 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 10m x 10m room -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 0.2 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10 0.2 2.0</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 0.2 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10 0.2 2.0</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>5 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10 2.0</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10 2.0</size></box></geometry></visual>
      </link>
    </model>

    <!-- Reference lane: increasing heights, same footprint -->
    <model name="obs_h03">
      <static>true</static>
      <pose>1.2 -1.4 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.40 0.28 0.03</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.40 0.28 0.03</size></box></geometry><material><diffuse>0.95 0.35 0.30 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obs_h05">
      <static>true</static>
      <pose>1.2 -0.8 0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.40 0.28 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.40 0.28 0.05</size></box></geometry><material><diffuse>0.97 0.65 0.20 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obs_h08">
      <static>true</static>
      <pose>1.2 -0.2 0.04 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.40 0.28 0.08</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.40 0.28 0.08</size></box></geometry><material><diffuse>0.24 0.60 0.90 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obs_h10">
      <static>true</static>
      <pose>1.2 0.4 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.40 0.28 0.10</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.40 0.28 0.10</size></box></geometry><material><diffuse>0.25 0.75 0.35 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obs_h12">
      <static>true</static>
      <pose>1.2 1.0 0.06 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.40 0.28 0.12</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.40 0.28 0.12</size></box></geometry><material><diffuse>0.78 0.42 0.86 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Mixed-shape lane -->
    <model name="shoe_like_low_04">
      <static>true</static>
      <pose>2.2 -1.2 0.02 0 0 0.25</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.26 0.12 0.04</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.26 0.12 0.04</size></box></geometry><material><diffuse>0.40 0.22 0.18 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cylinder_h06">
      <static>true</static>
      <pose>2.3 -0.5 0.03 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.06</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.06</length></cylinder></geometry><material><diffuse>0.85 0.48 0.30 1</diffuse></material></visual>
      </link>
    </model>

    <model name="barrier_h04_long">
      <static>true</static>
      <pose>2.5 0.2 0.02 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.60 0.08 0.04</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.60 0.08 0.04</size></box></geometry><material><diffuse>0.92 0.30 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box_h20">
      <static>true</static>
      <pose>2.8 1.0 0.10 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 0.35 0.20</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 0.35 0.20</size></box></geometry><material><diffuse>0.18 0.50 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Navigation references -->
    <model name="table_block_left">
      <static>true</static>
      <pose>-1.8 1.8 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.6 0.75</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 0.6 0.75</size></box></geometry><material><diffuse>0.50 0.38 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <model name="table_block_right">
      <static>true</static>
      <pose>-1.7 -1.8 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.6 0.75</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 0.6 0.75</size></box></geometry><material><diffuse>0.50 0.38 0.25 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
