<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="home_assistant_room">
    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <max_contacts>20</max_contacts>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::Magnetometer" filename="gz-sim-magnetometer-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.67 0.78 0.89 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>
    <atmosphere type="adiabatic"/>

    <light name="home_sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 25 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>200</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.25 0.2 -0.95</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.56 0.58 0.54 1</ambient>
            <diffuse>0.56 0.58 0.54 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer walls: 14m x 12m apartment shell with south door opening -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 6 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>14 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>14 0.2 2.5</size></box></geometry>
          <material><diffuse>0.76 0.76 0.79 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south_left">
      <static>true</static>
      <pose>-4.75 -6 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.5 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.5 0.2 2.5</size></box></geometry>
          <material><diffuse>0.76 0.76 0.79 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south_right">
      <static>true</static>
      <pose>4.75 -6 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.5 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.5 0.2 2.5</size></box></geometry>
          <material><diffuse>0.76 0.76 0.79 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>7 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 12 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 12 2.5</size></box></geometry>
          <material><diffuse>0.76 0.76 0.79 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-7 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 12 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 12 2.5</size></box></geometry>
          <material><diffuse>0.76 0.76 0.79 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Internal walls with door gaps -->
    <model name="inner_wall_left_top">
      <static>true</static>
      <pose>-1.5 4.2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 3.6 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 3.6 2.5</size></box></geometry>
          <material><diffuse>0.72 0.72 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="inner_wall_left_bottom">
      <static>true</static>
      <pose>-1.5 -0.6 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 2.8 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 2.8 2.5</size></box></geometry>
          <material><diffuse>0.72 0.72 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="inner_wall_mid_horizontal">
      <static>true</static>
      <pose>2.6 -1.6 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.8 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.8 0.2 2.5</size></box></geometry>
          <material><diffuse>0.72 0.72 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="inner_wall_right_vertical">
      <static>true</static>
      <pose>3.8 2.6 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 3.6 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 3.6 2.5</size></box></geometry>
          <material><diffuse>0.72 0.72 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Furniture and obstacles (all static for mapping/nav) -->
    <model name="dining_table">
      <static>true</static>
      <pose>5.0 3.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 1.1 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.0 1.1 0.8</size></box></geometry>
          <material><diffuse>0.45 0.32 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="coffee_table">
      <static>true</static>
      <pose>-4.3 3.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.7 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.7 0.5</size></box></geometry>
          <material><diffuse>0.42 0.28 0.17 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="kitchen_island">
      <static>true</static>
      <pose>4.7 -3.6 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.4 0.9 0.9</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.4 0.9 0.9</size></box></geometry>
          <material><diffuse>0.52 0.52 0.54 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="sofa_block">
      <static>true</static>
      <pose>-4.9 1.3 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.3 0.9 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.3 0.9 0.8</size></box></geometry>
          <material><diffuse>0.18 0.26 0.36 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="bed_block">
      <static>true</static>
      <pose>-4.8 -3.7 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 1.5 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.2 1.5 0.6</size></box></geometry>
          <material><diffuse>0.66 0.66 0.70 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_living">
      <static>true</static>
      <pose>0.8 4.7 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 2.0 1.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 2.0 1.8</size></box></geometry>
          <material><diffuse>0.33 0.33 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_kitchen">
      <static>true</static>
      <pose>5.8 0.0 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 1.8 1.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 1.8 1.8</size></box></geometry>
          <material><diffuse>0.33 0.33 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="plant_pot_1">
      <static>true</static>
      <pose>-0.2 5.2 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.22</radius><length>0.7</length></cylinder></geometry>
          <material><diffuse>0.32 0.23 0.17 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="plant_pot_2">
      <static>true</static>
      <pose>6.1 -4.8 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.22</radius><length>0.7</length></cylinder></geometry>
          <material><diffuse>0.32 0.23 0.17 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="chair_1">
      <static>true</static>
      <pose>4.2 2.2 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 0.45 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.45 0.45 0.6</size></box></geometry>
          <material><diffuse>0.17 0.17 0.19 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="chair_2">
      <static>true</static>
      <pose>5.8 2.2 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 0.45 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.45 0.45 0.6</size></box></geometry>
          <material><diffuse>0.17 0.17 0.19 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="center_column">
      <static>true</static>
      <pose>1.8 0.8 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 1.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 1.8</size></box></geometry>
          <material><diffuse>0.62 0.62 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
