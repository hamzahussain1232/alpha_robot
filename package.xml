<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>articubot_one</name>
  <version>0.0.1</version>
  <description>ROS2 Indoors and Outdoors Robots - launch and config package</description>
  <maintainer email="slg@quakemap.com">Sergei Grichine</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>xacro</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>
  <depend>cv_bridge</depend>

  <depend>controller_manager</depend>
  <depend>ros2_control</depend>
  <depend>ros2_controllers</depend>
  <depend>diff_drive_controller</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>robot_state_publisher</depend>
  <depend>twist_mux</depend>
  
  <exec_depend>ros_gz</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend> 
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>

  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>imu_tools</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>cartographer_ros</exec_depend>

  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_satellite</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>battery_state_rviz_overlay</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
