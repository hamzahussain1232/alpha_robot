<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <!-- Raspberry Pi Camera v2.1 approximate body dimensions. -->
    <xacro:property name="pi_cam_board_x" value="0.025"/>
    <xacro:property name="pi_cam_board_y" value="0.024"/>
    <xacro:property name="pi_cam_board_z" value="0.002"/>
    <xacro:property name="pi_cam_lens_radius" value="0.0045"/>
    <xacro:property name="pi_cam_lens_length" value="0.006"/>
    <xacro:property name="pi_cam_support_radius" value="0.004"/>
    <xacro:property name="pi_cam_support_length" value="0.030"/>

    <joint name="camera_joint" type="fixed">
      <parent link="chassis"/>
         <child link="camera_link"/>
         <origin xyz="${camera_offset_x} 0 ${camera_offset_z}" rpy="0 0 0"/>
    </joint>


    <link name="camera_link">
        <visual>
            <geometry>
                <box size="${pi_cam_board_x} ${pi_cam_board_y} ${pi_cam_board_z}"/>
            </geometry>
            <material name="blue">
                 <color rgba="0.2 0.2 1 1"/>
            </material>
        </visual>
        <visual>
            <origin xyz="${pi_cam_board_x/2 + pi_cam_lens_length/2} 0 0"/>
            <geometry>
                <cylinder radius="${pi_cam_lens_radius}" length="${pi_cam_lens_length}"/>
            </geometry>
            <material name="black"/>
        </visual>
        <visual>
            <origin xyz="0 0 ${-(pi_cam_support_length/2 + pi_cam_board_z/2)}"/>
            <geometry>
                <cylinder radius="${pi_cam_support_radius}" length="${pi_cam_support_length}"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <box size="${pi_cam_board_x} ${pi_cam_board_y} ${pi_cam_board_z}"/>
            </geometry>
        </collision>
        <collision>
            <origin xyz="${pi_cam_board_x/2 + pi_cam_lens_length/2} 0 0"/>
            <geometry>
                <cylinder radius="${pi_cam_lens_radius}" length="${pi_cam_lens_length}"/>
            </geometry>
        </collision>
        <collision>
            <origin xyz="0 0 ${-(pi_cam_support_length/2 + pi_cam_board_z/2)}"/>
            <geometry>
                <cylinder radius="${pi_cam_support_radius}" length="${pi_cam_support_length}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.01" x="${pi_cam_board_x}" y="${pi_cam_board_y}" z="${pi_cam_board_z}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="camera_link_optical">
    </link>

    <gazebo reference="camera_link">
        <sensor name='rgb_camera' type='camera'>
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            
            <topic>camera/image_raw</topic> 
            <gz_frame_id>camera_link_optical</gz_frame_id>
            <camera name='__default__'>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>8.0</far>
                </clip>
                <optical_frame_id>camera_link_optical</optical_frame_id>
            </camera>
            
            </sensor>
    </gazebo>

</robot>
