<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:arg name="lidar_offset_x" default="-0.0885"/>
    <xacro:arg name="lidar_offset_y" default="0.0"/>
    <!-- Relative height above chassis top (meters), to LiDAR center. -->
    <xacro:arg name="lidar_offset_z" default="0.0275"/>
    <!-- Yaw of the physical LiDAR mounting relative to the robot front. -->
    <xacro:arg name="lidar_yaw" default="0.0"/>
    <xacro:arg name="lidar_min_angle" default="-3.14159"/>
    <xacro:arg name="lidar_max_angle" default="3.14159"/>
    <xacro:property name="lidar_offset_x_val" value="$(arg lidar_offset_x)"/>
    <xacro:property name="lidar_offset_y_val" value="$(arg lidar_offset_y)"/>
    <xacro:property name="lidar_offset_z_val" value="$(arg lidar_offset_z)"/>
    <xacro:property name="lidar_yaw_val" value="$(arg lidar_yaw)"/>
    <!-- RPLidar A1 physical envelope from provided dimensions: 70mm diameter, ~55mm height. -->
    <xacro:property name="lidar_body_radius" value="0.035"/>
    <xacro:property name="lidar_body_height" value="0.055"/>
    <xacro:property name="lidar_body_mass" value="0.17"/>
    
    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/>
        <child link="laser_frame"/>
        <origin xyz="${lidar_offset_x_val} ${lidar_offset_y_val} ${chassis_height + lidar_offset_z_val}" rpy="0 0 ${lidar_yaw_val}"/>
    </joint>
    <gazebo reference="laser_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="${lidar_body_radius}" length="${lidar_body_height}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${lidar_body_radius}" length="${lidar_body_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${lidar_body_mass}" length="${lidar_body_height}" radius="${lidar_body_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="laser_frame">
        <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="laser_frame">
        <sensor name='laser_sensor' type='gpu_lidar'>
          <pose>0 0 0 0 0 0</pose>
          <always_on>1</always_on>
          <!-- Stable sim profile for mapping: more temporal samples during turns. -->
          <update_rate>12.0</update_rate>
          <topic>/scan</topic>
          <gz_frame_id>laser_frame</gz_frame_id>
          <frame_id>laser_frame</frame_id>
          <visualize>false</visualize> <ray>
            <scan>
              <horizontal>
                <!-- 360 samples/scan @ 12Hz gives cleaner scan matching during turns. -->
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>$(arg lidar_min_angle)</min_angle>
                <max_angle>$(arg lidar_max_angle)</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.15</min> <max>6.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.005</stddev>
            </noise>
          </ray>
        </sensor>
    </gazebo>

</robot>
