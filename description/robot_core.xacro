<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <xacro:include filename="inertial_macros.xacro" />
    <!-- Real hardware body size: 32 cm x 27 cm (without tyres). -->
    <xacro:property name="chassis_length" value="0.32"/>
    <xacro:property name="chassis_width" value="0.27"/>
    <!-- Body top target from ground is ~12.6 cm with current tyres. -->
    <xacro:property name="chassis_height" value="0.0795"/>
    <xacro:property name="chassis_mass" value="3.0"/>
    <xacro:property name="wheel_radius" value="0.0425"/>
    <xacro:property name="wheel_thickness" value="0.04"/>
    <xacro:property name="wheel_mass" value="0.2"/>
    <xacro:property name="wheel_offset_x" value="0.11"/>
    <xacro:property name="wheel_offset_y" value="${(chassis_width / 2.0) + (wheel_thickness / 2.0)}"/>
    <xacro:property name="chassis_ground_clearance" value="0.004"/>

    <link name="base_link"></link>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="0 0 ${wheel_radius + chassis_ground_clearance}"/>
    </joint>

    <link name="chassis">
        <visual>
            <origin xyz="0 0 ${chassis_height/2}"/>
            <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${chassis_height/2}"/>
            <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
        </collision>
        <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
            <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="${x_reflect*wheel_offset_x} ${y_reflect*wheel_offset_y} ${wheel_radius}" rpy="${-pi/2} 0 0" />
            <axis xyz="0 0 1"/>
            <dynamics damping="0.2" friction="0.05"/>
        </joint>
        <link name="${prefix}_wheel">
            <visual>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_thickness}"/></geometry>
                <material name="blue"/>
            </visual>
            <collision>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_thickness}"/></geometry>
            </collision>
            <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}" radius="${wheel_radius}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>
        <gazebo reference="${prefix}_wheel">
            <material>Gazebo/Blue</material>
            <!-- Skid-steer tuning: allow controlled lateral slip so turning matches odometry better. -->
            <mu1>0.7</mu1>
            <mu2>0.5</mu2>
            <slip1>0.02</slip1>
            <slip2>0.12</slip2>
            <kp>1000000.0</kp>
            <kd>1.0</kd>
        </gazebo>
    </xacro:macro>

    <xacro:wheel prefix="front_left" x_reflect="1" y_reflect="1" />
    <xacro:wheel prefix="front_right" x_reflect="1" y_reflect="-1" />
    <xacro:wheel prefix="rear_left" x_reflect="-1" y_reflect="1" />
    <xacro:wheel prefix="rear_right" x_reflect="-1" y_reflect="-1" />

    <gazebo reference="chassis"><material>Gazebo/Black</material></gazebo>

</robot>
