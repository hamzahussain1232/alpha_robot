<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <!-- Real hardware profile: base plate ~9cm x 4cm. -->
    <xacro:property name="arm_base_size_x" value="0.09"/>
    <xacro:property name="arm_base_size_y" value="0.04"/>
    <xacro:property name="arm_base_length" value="0.030"/>
    <xacro:property name="arm_base_mass" value="0.20"/>

    <xacro:property name="link_1_radius" value="0.0175"/>
    <xacro:property name="link_1_length" value="0.025"/>
    <xacro:property name="link_1_mass" value="0.10"/>

    <xacro:property name="link_2_radius" value="0.0175"/>
    <xacro:property name="link_2_length" value="0.100"/>
    <xacro:property name="link_2_mass" value="0.15"/>

    <xacro:property name="link_3_radius" value="0.0175"/>
    <xacro:property name="link_3_length" value="0.105"/>
    <xacro:property name="link_3_mass" value="0.13"/>

    <xacro:property name="link_4_radius" value="0.0175"/>
    <xacro:property name="link_4_length" value="0.070"/>
    <xacro:property name="link_4_mass" value="0.08"/>

    <xacro:property name="link_5_radius" value="0.0175"/>
    <xacro:property name="link_5_length" value="0.030"/>
    <xacro:property name="link_5_mass" value="0.06"/>

    <xacro:property name="link_6_radius" value="0.0175"/>
    <xacro:property name="link_6_length" value="0.084"/>
    <xacro:property name="link_6_mass" value="0.05"/>

    <joint name="arm_base_joint" type="fixed">
        <parent link="chassis"/>
        <child link="arm_base_link"/>
        <!-- Arm base center is 7.5 cm from front; robot half-length is 14.65 cm. -->
        <origin xyz="0.0715 0 ${chassis_height}" rpy="0 0 0"/>
    </joint>

    <link name="arm_base_link">
        <visual>
            <origin xyz="0 0 ${arm_base_length/2}"/>
            <geometry><box size="${arm_base_size_x} ${arm_base_size_y} ${arm_base_length}"/></geometry>
            <material name="orange"><color rgba="1 0.3 0.1 1"/></material>
        </visual>
        <collision>
            <origin xyz="0 0 ${arm_base_length/2}"/>
            <geometry><box size="${arm_base_size_x} ${arm_base_size_y} ${arm_base_length}"/></geometry>
        </collision>
        <xacro:inertial_box mass="${arm_base_mass}" x="${arm_base_size_x}" y="${arm_base_size_y}" z="${arm_base_length}">
            <origin xyz="0 0 ${arm_base_length/2}" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="joint_1" type="revolute">
        <parent link="arm_base_link"/>
        <child link="link_1"/>
        <origin xyz="0 0 ${arm_base_length}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="100" velocity="1"/>
    </joint>

    <link name="link_1">
        <visual>
            <origin xyz="0 0 ${link_1_length/2}"/>
            <geometry><cylinder radius="${link_1_radius}" length="${link_1_length}"/></geometry>
            <material name="yellow"><color rgba="1 1 0 1"/></material>
        </visual>
        <collision>
            <origin xyz="0 0 ${link_1_length/2}"/>
            <geometry><cylinder radius="${link_1_radius}" length="${link_1_length}"/></geometry>
        </collision>
        <xacro:inertial_cylinder mass="${link_1_mass}" length="${link_1_length}" radius="${link_1_radius}">
            <origin xyz="0 0 ${link_1_length/2}" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <joint name="joint_2" type="revolute">
        <parent link="link_1"/>
        <child link="link_2"/>
        <origin xyz="0 0 ${link_1_length}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="100" velocity="1"/>
    </joint>

    <link name="link_2">
        <visual>
            <origin xyz="0 0 ${link_2_length/2}"/>
            <geometry><cylinder radius="${link_2_radius}" length="${link_2_length}"/></geometry>
            <material name="white"><color rgba="1 1 1 1"/></material>
        </visual>
        <collision>
            <origin xyz="0 0 ${link_2_length/2}"/>
            <geometry><cylinder radius="${link_2_radius}" length="${link_2_length}"/></geometry>
        </collision>
        <xacro:inertial_cylinder mass="${link_2_mass}" length="${link_2_length}" radius="${link_2_radius}">
            <origin xyz="0 0 ${link_2_length/2}" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <joint name="joint_3" type="revolute">
        <parent link="link_2"/>
        <child link="link_3"/>
        <origin xyz="0 0 ${link_2_length}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.5" upper="2.5" effort="100" velocity="1"/>
    </joint>

    <link name="link_3">
        <visual>
            <origin xyz="0 0 ${link_3_length/2}"/>
            <geometry><cylinder radius="${link_3_radius}" length="${link_3_length}"/></geometry>
            <material name="blue"><color rgba="0.2 0.2 1 1"/></material>
        </visual>
        <collision>
            <origin xyz="0 0 ${link_3_length/2}"/>
            <geometry><cylinder radius="${link_3_radius}" length="${link_3_length}"/></geometry>
        </collision>
        <xacro:inertial_cylinder mass="${link_3_mass}" length="${link_3_length}" radius="${link_3_radius}">
            <origin xyz="0 0 ${link_3_length/2}" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <joint name="joint_4" type="revolute">
        <parent link="link_3"/>
        <child link="link_4"/>
        <origin xyz="0 0 ${link_3_length}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-3.14" upper="3.14" effort="100" velocity="1"/>
    </joint>

    <link name="link_4">
        <visual>
            <origin xyz="0 0 ${link_4_length/2}"/>
            <geometry><cylinder radius="${link_4_radius}" length="${link_4_length}"/></geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${link_4_length/2}"/>
            <geometry><cylinder radius="${link_4_radius}" length="${link_4_length}"/></geometry>
        </collision>
        <xacro:inertial_cylinder mass="${link_4_mass}" length="${link_4_length}" radius="${link_4_radius}">
            <origin xyz="0 0 ${link_4_length/2}" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <joint name="joint_5" type="revolute">
        <parent link="link_4"/>
        <child link="link_5"/>
        <origin xyz="0 0 ${link_4_length}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="100" velocity="1"/>
    </joint>

    <link name="link_5">
        <visual>
            <origin xyz="0 0 ${link_5_length/2}"/>
            <geometry><cylinder radius="${link_5_radius}" length="${link_5_length}"/></geometry>
            <material name="yellow"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${link_5_length/2}"/>
            <geometry><cylinder radius="${link_5_radius}" length="${link_5_length}"/></geometry>
        </collision>
        <xacro:inertial_cylinder mass="${link_5_mass}" length="${link_5_length}" radius="${link_5_radius}">
            <origin xyz="0 0 ${link_5_length/2}" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <joint name="joint_6" type="revolute">
        <parent link="link_5"/>
        <child link="link_6"/>
        <origin xyz="0 0 ${link_5_length}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-3.14" upper="3.14" effort="100" velocity="1"/>
    </joint>

    <link name="link_6">
        <visual>
            <origin xyz="0 0 ${link_6_length/2}"/>
            <geometry><cylinder radius="${link_6_radius}" length="${link_6_length}"/></geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${link_6_length/2}"/>
            <geometry><cylinder radius="${link_6_radius}" length="${link_6_length}"/></geometry>
        </collision>
        <xacro:inertial_cylinder mass="${link_6_mass}" length="${link_6_length}" radius="${link_6_radius}">
            <origin xyz="0 0 ${link_6_length/2}" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

</robot>
